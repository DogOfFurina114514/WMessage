{
  "name": "wmessage-desktop",
  "productName": "WMessage",
  "version": "1.0.0",
  "description": "WMessage 桌面客户端（Electron 嵌套 GitHub Pages 网页）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.wmessage.app",
    "productName": "WMessage",
    "files": ["main.js", "preload.js", "icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "WMessage" },
    "mac": { "target": "dmg", "icon": "icon.png", "category": "public.app-category.social-networking" },
    "linux": { "target": "AppImage", "icon": "icon.png", "category": "Network" }
  }
}
